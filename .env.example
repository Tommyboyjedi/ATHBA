DJANGO_SECRET_KEY=replace-me
DEBUG=false
CPU_ONLY=true
DEVOPS_DIR=/tmp/athba_repos

# MongoDB contract used by core.infra.mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=ai_platform
MONGO_USER=athba
MONGO_PASS=replace-me

# OpenAI-compatible provider settings
OPENAI_API_KEY=
OPENAI_ORG=
OPENAI_PROJECT=
OPENAI_API_BASE=

# Anthropic provider settings
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4.5-20250514

# Legacy compatibility stack only; modern PR17+ orchestration does not require this
LLM_SERVER_URL=http://127.0.0.1:8011
